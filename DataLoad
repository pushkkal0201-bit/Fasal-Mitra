        vis:{min:-0.35,max:0.35,palette:['BB3B3B','F8F4D2','16844C']},
        note:'Same calendar 30-day window one year earlier; missing observations stay missing'},
      {name:'v21: Seasonal vegetation decline screen',image:riskData.vegetationDownturn.selfMask(),
        vis:{min:0,max:1,palette:['C75148']},note:'Measured NDVI drop below -0.15; not confirmed crop switch'}
    ] : [
      {name:'v21: Possible temporary water screen',image:riskData.flood.selfMask(),
        vis:{min:0,max:1,palette:['2674C4']},note:'Optical MNDWI/NDVI or radar dark-return indicator; NOT flood confirmation'},
      {name:'v21: Rainfall deficit vegetation screen',image:riskData.drought.selfMask(),
        vis:{min:0,max:1,palette:['D58B3C']},note:'CHIRPS rainfall anomaly below -30% and low observed NDVI; screening only'},
      {name:'v21: Rainfall anomaly percent',image:riskData.rainfallAnomaly,
        vis:{min:-80,max:80,palette:['BA643D','F1E3B1','3F89C0']},
