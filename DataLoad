      if(options.onLayerRequested(name))return;
    }
    if(!x.image && name!=='Satellite basemap (instant)'){
      // No rendering of empty rasters or false claims that this layer exists.
      status.setValue('This layer requires satellite processing, model training, or additional data: '+name);
      if(x.checkbox)x.checkbox.setValue(false,false);
      updateParameterCard(name);
      drawLegend(name);
      return;
    }
    Object.keys(layers).forEach(function(key){var entry=layers[key];
      if(!entry.overlay && entry.layer && entry.layer.setShown){
        entry.layer.setShown(key===name);
        if(entry.checkbox)entry.checkbox.setValue(key===name,false);
      }
    });
    baseLayer=ensureLayer(name);
    if(baseLayer){baseLayer.setShown(true);baseLayer.setOpacity(opacity.getValue());}
    if(comparisonEnabled && comparisonLayer){
      try{map.layers().remove(comparisonLayer);}catch(ignored){}
      map.layers().add(comparisonLayer);
