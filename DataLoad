  function openTab(tab){
    if(!lastData)return;
    try{app.refreshData(ensureFor(tab));}
    catch(e){app.error('Failed to open '+tab+': '+String(e));}
  }
  function ensureCore(){
    if(baseData)return lastData;
    if(!lastData)return null;
    var base=M.data.load(input);baseData=base;
    base.quickS2=lastData && lastData.quickS2;
    base.quickInspector=lastData && lastData.quickInspector;
    base.adminBoundary=base.district;
    base.trainingImports=importNames;
    base.trainingLayers=M.crop.trainingLayers(input);
    base.trainingOverlay=M.crop.collectTraining(input);
    base.sampleInventory=ee.FeatureCollection([
      ee.Feature(null,{Crop:'All 8 embedded classes',ClassID:0,Input_Features:260})]);
    var imageMode=M.crop.load(args(base));
    var d=M.health.load(args(imageMode));d=M.decision.load(args(d));
    d._fastLoaded={core:true};d._overviewDetailed=!!lastData._overviewDetailed;
    baseData=base;lastData=d;app.render(d);
    return d;
  }
  function loadLayer(name){
    if(!name || name==='Satellite basemap (instant)' || name==='Fast Sentinel-2 RGB (4 scenes)' || baseData)return false;
    try{ensureCore();app.selectLayer(name);return true;}
    catch(e){app.error('Satellite layer could not be constructed: '+String(e));return true;}
  }
  function run(changes){
    var id=++runId;
    Object.keys(changes||{}).forEach(function(k){CONFIG[k]=changes[k];});
    // Honor district/state changes from the UI; recompute the AOI before preview.
    PHENO_setDistrictAOI();
    if(manualSamples.length){
      try{syncManual(CONFIG.ANALYSIS_DATE);}
      catch(e){app.error(String(e));return;}
    }
    if(reportView && reportView.closeReport)reportView.closeReport();
    app.invalidate();app.setModelState('idle','');app.trainButton.setDisabled(false);app.setBusy(true);
    evidenceResult=null;app.setEvidenceState('idle','Period or location changed: rerun spatial validation.');
    app.setQAState('idle','Period changed: rerun live reliability checks.');
    app.evidenceButton.setDisabled(false);
    app.status.setValue('Satellite basemap ready. Select an Earth Engine layer to fetch S1/S2 images.');
    try{
      baseData=null; // No server-side satellite graph is built at startup.
      var selectedDate=M.data.dateWindow(CONFIG).analysisDate;
      CONFIG.ANALYSIS_DATE=selectedDate;
      // Light preview within the selected interval; full model remains lazy.
      var selectedWindow=M.data.dateWindow(CONFIG);
      CONFIG.SELECTED_START=selectedWindow.startDate;
      CONFIG.SELECTED_END=selectedWindow.endDate;
      var quickCollection=ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
        .filterBounds(input.aoi)
        .filterDate(ee.Date(selectedWindow.start),ee.Date(selectedWindow.end))
        .filter(ee.Filter.lte('CLOUDY_PIXEL_PERCENTAGE',60))
        .sort('CLOUDY_PIXEL_PERCENTAGE').limit(4)
        .map(function(image){
          var scl=image.select('SCL');
          var good=scl.neq(0).and(scl.neq(1)).and(scl.neq(3))
            .and(scl.neq(8)).and(scl.neq(9)).and(scl.neq(10)).and(scl.neq(11));
          return image.updateMask(good).select(['B2','B3','B4','B8','B11']).divide(10000);
        });
      var quickFull=ee.Image(ee.Algorithms.If(quickCollection.size().gt(0),
        quickCollection.median(),ee.Image.constant([0,0,0,0,0])
        .rename(['B2','B3','B4','B8','B11']).updateMask(ee.Image.constant(0)))).clip(input.aoi);
      var quickRGB=quickFull.select(['B4','B3','B2']);
      var quickWeather=ee.ImageCollection('ECMWF/ERA5_LAND/HOURLY')
        .filterBounds(input.aoi)
        .filterDate(ee.Date(selectedWindow.end).advance(-7,'day'),ee.Date(selectedWindow.end))
        .select('temperature_2m').sort('system:time_start',false).limit(24);
      var quickTemp=ee.Image(ee.Algorithms.If(quickWeather.size().gt(0),
        quickWeather.mean().subtract(273.15).rename('temperature_coarse'),
        ee.Image.constant(0).rename('temperature_coarse').updateMask(ee.Image.constant(0))));
      var quickNDVI=quickFull.normalizedDifference(['B8','B4']).rename('NDVI');
      var quickNDMI=quickFull.normalizedDifference(['B8','B11']).rename('NDMI');
      var adminBoundary=PHENO_districtFeatures(CONFIG);
      var empty={CONFIG:CONFIG,aoi:input.aoi,adminBoundary:adminBoundary,
        summaryScope:'Satellite basemap only',quickS2:quickRGB,
        quickInspector:quickNDVI.addBands(quickNDMI).addBands(quickTemp),
        modelAvailable:false,_overviewDetailed:false,_hasCore:false,_fastLoaded:{},
        trainingImports:importNames,trainingLayers:M.crop.trainingLayers(input),
        trainingOverlay:M.crop.collectTraining(input),
        sampleInventory:ee.FeatureCollection([ee.Feature(null,{Crop:'All 8 embedded classes',
          ClassID:0,Input_Features:260})])};
      if(id!==runId)return;
      lastData=empty;app.render(empty);
      app.status.setValue('Quick dashboard ready. Satellite layers, risk maps and model evaluation load only when requested.');
    }catch(e){app.error('Fast start failed: '+String(e));}
  }
  function loadSpatialPerClass(done){
    if(!evidenceResult){done([],'Run the spatial cross-validation experiment first.');return;}
    evidenceResult.perClass.sort('class_id').limit(8).evaluate(function(fc,error){
      if(error){done([],error);return;}
      done((fc&&fc.features||[]).map(function(f){return f.properties||{};}),null);
    });
  }

  function loadFoldDetails(done){
    if(!evidenceResult){done([], 'Run the spatial five-fold experiment first.');return;}
    evidenceResult.folds.sort('fold').limit(5).evaluate(function(fc,error){
      if(error){done([],error);return;}
      done((fc&&fc.features||[]).map(function(f){return f.properties||{};}),null);
    });
  }
  function runDiagnostics(){
    var id=runId;
    var local=M.assurance.localChecks(CONFIG);
    app.goTo('System tests');app.setQAState('running','Evaluating Earth Engine data integrity and missing-data behavior…');
    try{ensureCore();}catch(e){app.setQAMetrics(local,null,'Preprocessing error: '+String(e));return;}
    try{M.assurance.serverChecks(baseData).evaluate(function(server,error){
      if(id!==runId)return;
      app.setQAMetrics(local,server,error||(!server?'No Earth Engine results':null));
      print('फसल-मित्र v13 SYSTEM DIAGNOSTICS',local,server,error);
    });}catch(e){app.setQAMetrics(local,null,String(e));}
  }

  // SCIENCE AUDIT: does not silently treat 260 point labels as verified truth.
  function runEvidence(){
    var id=runId;
    try{ensureCore();}catch(e){app.setEvidenceState('error','Cannot load predictors: '+String(e));return;}
    app.evidenceButton.setDisabled(true);
    app.setEvidenceState('running','Five spatial folds may take several minutes. Do not change the analysis period.');
    app.goTo('Scientific evidence');
    var result;
    try{result=M.evidence.build(baseData);evidenceResult=result;}
    catch(e){app.evidenceButton.setDisabled(false);app.setEvidenceState('error',String(e));return;}
    result.summary.evaluate(function(metrics,error){
      if(id!==runId)return;
      app.evidenceButton.setDisabled(false);
      if(error || !metrics){app.setEvidenceState('error','Earth Engine: '+String(error));print('EVIDENCE ERROR',error);return;}
      print('फसल-मित्र v13 SPATIAL CV EVIDENCE (EXPERIMENTAL)',metrics);
      print('IMPORTANT: Verification status:',metrics.label_evidence_status);
      app.setEvidenceMetrics(metrics);
      app.status.setValue(metrics.complete_fold_and_class_coverage===1 || metrics.complete_fold_and_class_coverage===true ?
        'Spatial experiment computed across all folds and classes; inspect accuracy, Kappa and label limitations.' :
        'Spatial experiment has incomplete fold/class coverage; do not report this as a final model score.');
    });
  }
  function exportAudit(){
    Export.table.toDrive({collection:PHENO_ALL_LABELS,
      description:'FasalMitra_v13_Ground_Truth_Verification_Sheet',folder:CONFIG.EXPORT_FOLDER,
      fileFormat:'CSV',selectors:['source_id','crop','class','longitude','latitude',
        'label_date','label_source','review_flag','training_eligible']});
    app.status.setValue('Ground-truth audit CSV task created. Start it in Tasks.');
  }
  function exportEvidence(){
    if(!evidenceResult){app.status.setValue('Run spatial cross-validation before exporting evidence.');return;}
    var r=evidenceResult,day=(CONFIG.ANALYSIS_DATE||'unknown').replace(/-/g,'');
    var metrics=r.summary.remove('matrix');
    Export.table.toDrive({collection:ee.FeatureCollection([ee.Feature(null,metrics)]),
      description:'FasalMitra_v13_Spatial_Metrics_'+day,folder:CONFIG.EXPORT_FOLDER,fileFormat:'CSV'});
    Export.table.toDrive({collection:r.predictions,
      description:'FasalMitra_v13_OutOfFold_Predictions_'+day,folder:CONFIG.EXPORT_FOLDER,fileFormat:'CSV',
      selectors:['source_id','crop','class','predicted','baseline_predicted','evidence_fold',
        'spatial_fold','block_e','block_n','correct','dataset_status']});
    Export.table.toDrive({collection:r.perClass,
      description:'FasalMitra_v13_PerClass_Metrics_'+day,folder:CONFIG.EXPORT_FOLDER,fileFormat:'CSV'});
    Export.table.toDrive({collection:r.folds,
      description:'FasalMitra_v13_Spatial_Fold_Metrics_'+day,folder:CONFIG.EXPORT_FOLDER,fileFormat:'CSV'});
    Export.table.toDrive({collection:r.confusion,
      description:'FasalMitra_v13_Spatial_Confusion_8x8_'+day,
      folder:CONFIG.EXPORT_FOLDER,fileFormat:'CSV'});
    app.status.setValue('Five evidence CSV exports created. Start each task from the Earth Engine Tasks tab.');
  }
  function trainNow(){
    try{ensureCore();}catch(e){app.setModelState('error','Satellite preparation failed: '+String(e));app.error('Satellite preparation failed: '+String(e));return;}
    var id=runId;
    app.trainButton.setDisabled(true);
    app.setModelState('preparing','Preparing satellite predictors and checking the 252 eligible labels…');
    app.goTo('Model performance');
    app.status.setValue('Preparing 252 eligible labels from 260 supplied points. Dashboard remains usable.');
    var p;
    try{
      // The data module already built seasonal predictors. Adding a second
      // derived trend graph to every pixel was an expensive, optional step.
      p=M.crop.prepare(args(baseData));
    }catch(e){app.trainButton.setDisabled(false);app.setModelState('error','Sample preparation failed: '+String(e));app.error('Sample preparation: '+e);return;}
    p.diagnostics.evaluate(function(diag,error){
      if(id!==runId)return;
      if(error || !diag){app.trainButton.setDisabled(false);app.setModelState('error','Training check failed: '+String(error));app.status.setValue('Training check failed. '+String(error));return;}
      print('Eight-crop training diagnostics',diag);
      if(!diag.canTrain){
        var out=M.data.copy(lastData);out.trainingDiagnostics=p.diagnostics;
        lastData=out;app.refreshData(out);
        app.trainButton.setDisabled(false);app.setModelState('error','Training checks failed (canTrain=0). Inspect Console class and satellite coverage.');
        app.status.setValue('Training stopped: insufficient usable satellite pixels or crop classes. See Console and Training samples.');return;
      }
      try{
        var o=args(baseData);o.modelReady=true;o.prepared=p;o.trainingDiagnostics=diag;
        var classified=M.crop.load(o);
        if(!classified.modelAvailable){
          app.trainButton.setDisabled(false);app.setModelState('error','Model activation rejected. Inspect canTrain/modelReady in Console.');
          app.error('Training gate rejected the model; inspect canTrain and modelReady in Console.');
          print('MODEL_GATE_FAILED: canTrain flag =',diag.canTrain,'modelReady =',o.modelReady);
          return;
        }
        print('फसल-मित्र v13: classifier graph activated; evaluating predictions.');
        // Train once, without blocking UI for extra classifier.explain() query.
        // The model itself remains deferred on Earth Engine until requested.
        var d=M.health.load(args(classified));d=M.decision.load(args(d));
        d.quickS2=lastData && lastData.quickS2;
        d.quickInspector=lastData && lastData.quickInspector;
        d.adminBoundary=lastData && lastData.adminBoundary;
        d.trainingImports=importNames;d.trainingLayers=M.crop.trainingLayers(input);
        d.trainingOverlay=M.crop.collectTraining(input);
        d.trainingDiagnostics=p.diagnostics;
        d._fastLoaded={core:true};d._overviewDetailed=false;
        lastData=d;
        app.render(d);
        app.setModelState('evaluating','Training graph ready; computing actual holdout Accuracy and Kappa on Earth Engine…');
        app.status.setValue('Training graph built; computing held-out accuracy on Earth Engine…');
        d.validationMetrics.evaluate(function(metrics,modelError){
          if(id!==runId)return;
          if(modelError || !metrics){
            app.trainButton.setDisabled(false);app.setModelMetrics(null,modelError||'No evaluation result');
            app.status.setValue('ML training/accuracy evaluation failed: '+String(modelError));
            print('Classifier evaluation error',modelError);
            return;
          }
          app.trainButton.setDisabled(false);app.setModelMetrics(metrics,null);
          print('फसल-मित्र v13 HOLDOUT DIAGNOSTICS',metrics);
          print('फसल-मित्र v13 HOLDOUT ACCURACY',metrics.accuracy);
          print('फसल-मित्र v13 HOLDOUT KAPPA',metrics.kappa);
          if(typeof metrics.accuracy!=='number' || !isFinite(metrics.accuracy)){
            app.status.setValue('Model accuracy NOT available: only '+
              String(metrics.evaluated_predictions || 0)+' evaluable holdout predictions (need '+
              String(metrics.min_test_samples || 'more')+'). See Console and Quality & models.');
            print('VALIDATION NEEDS ATTENTION: No reliable accuracy value. '+
              'Inspect evaluated_predictions, expected_holdout_samples, '+
              'true_class_counts and dropped_or_unpredicted.',metrics);
          } else {
            app.status.setValue('Evaluated '+metrics.evaluated_predictions+
              ' holdout predictions; correct: '+metrics.correct_predictions+
              '; holdout accuracy: '+(metrics.accuracy*100).toFixed(1)+
              '%, Kappa: '+(typeof metrics.kappa==='number' ? metrics.kappa.toFixed(3) : 'N/A')+
              '. NOT spatially independent; verify labels and seasons.');
          }
        });
      }catch(e){app.trainButton.setDisabled(false);app.setModelState('error','Classifier construction: '+String(e));app.error('Classifier construction: '+String(e));}
    });
  }
  run({});
