          status.setValue('Rectangle corners must differ in latitude and longitude.');return;
        }
        polygon=ee.Geometry.Rectangle([Math.min(a[0],b[0]),Math.min(a[1],b[1]),
          Math.max(a[0],b[0]),Math.max(a[1],b[1])],null,false);
      }else{
        if(!isNonDegeneratePolygon(drawVertices)){
