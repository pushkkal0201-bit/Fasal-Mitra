PHENO_MODULES.decision = (function() {
var exports = {};
// Module 04 — heuristic inspection priority; not a calibrated agronomic prescription.
exports.load=function(options) {
  var U=PHENO_MODULES.data;
  var d=U.copy(options.data),C=d.CONFIG;
  d.yieldIndex=d.healthScore.multiply(0.7).add(d.NDMI.add(1).divide(2).multiply(30))
    .clamp(0,100).rename('Yield_Index').updateMask(d.healthScore.mask());
  d.priorityMap=d.weightedStressScore.multiply(0.7).add(ee.Image.constant(100).subtract(d.healthScore).multiply(0.3))
    .clamp(0,100).rename('Action_Priority');
  d.irrigationNeed=d.NDMI.lt(0.2).rename('Irrigation_Flag').updateMask(d.healthScore.mask());
  d.heatStress=d.temperature.gt(35).rename('Heat_Flag').updateMask(d.healthScore.mask());
  d.diseaseRiskIndicator=d.temperature.gte(25).and(d.temperature.lte(35)).and(d.NDMI.gt(0.25))
    .rename('Disease_Risk').updateMask(d.healthScore.mask());
  // Low NDVI is a request to inspect vigour, not proof of nutrient deficiency.
  d.fertilizerNeed=d.NDVI.lt(0.35).rename('Fertilizer_Flag').updateMask(d.healthScore.mask());
  d.hotspotScore=d.priorityMap.multiply(0.5).add(d.weightedStressScore.multiply(0.3))
    .add(d.irrigationNeed.multiply(20)).clamp(0,100).rename('Hotspot_Score');
  d.hotspotCategory=d.hotspotScore.gte(25).add(d.hotspotScore.gte(50)).add(d.hotspotScore.gte(75))
    .rename('Hotspot_Category');
  d.reliabilityIndex=d.confidence.rename('Reliability_Index');
  d.analysisStack=d.monitoringStack.addBands([d.yieldIndex,d.priorityMap,d.irrigationNeed,
    d.heatStress,d.diseaseRiskIndicator,d.reliabilityIndex,d.fertilizerNeed,d.hotspotScore,d.hotspotCategory]);
  d.districtAverages=U.stats(d.analysisStack,d.aoi,C);
  var area=ee.Image.pixelArea().divide(10000);
  var observedArea=area.updateMask(d.healthScore.mask()).rename('Observed_Crop_Area_ha');
  var riskAreas=observedArea.addBands([
    area.multiply(d.irrigationNeed).rename('Irrigation_Flag_Area_ha'),
    area.multiply(d.fertilizerNeed).rename('Low_Vigour_Area_ha'),
    area.multiply(d.diseaseRiskIndicator).rename('Disease_Flag_Area_ha'),
    area.multiply(d.heatStress).rename('Heat_Flag_Area_ha'),
    area.multiply(d.hotspotScore.gte(75)).rename('Critical_Hotspot_Area_ha')]);
  d.riskAreaSummary=ee.Dictionary(riskAreas.reduceRegion({reducer:ee.Reducer.sum(),geometry:d.aoi,
    scale:C.STATS_SCALE,crs:C.ANALYSIS_CRS,maxPixels:1e13,tileScale:4}));
  d.riskAreaSummary=d.riskAreaSummary.set('area_statistics_scale_m',C.STATS_SCALE);
  d.riskAreaReport=ee.FeatureCollection([ee.Feature(null,d.riskAreaSummary).set({District:C.DISTRICT,
    Analysis_Date:C.ANALYSIS_DATE,Scope:d.summaryScope,Interpretation:'Heuristic inspection flags; not diagnoses or prescriptions'})]);
  if(d.modelAvailable) {
    var names=['NDVI','NDMI','NDWI','EVI','Temperature','Rainfall','Health_Score','Stress_Score',
      'Yield_Index','Action_Priority','Irrigation_Flag','Heat_Flag','Disease_Risk','Reliability_Index',
      'Fertilizer_Flag','Hotspot_Score'];
    var grouped=d.analysisStack.select(names).addBands(d.classified).reduceRegion({
      reducer:ee.Reducer.mean().forEach(names).group({groupField:names.length,groupName:'ClassID'}),
      geometry:d.aoi,scale:C.STATS_SCALE,crs:C.ANALYSIS_CRS,maxPixels:1e13,tileScale:4});
    var groupedArea=observedArea.addBands(d.classified).reduceRegion({
      reducer:ee.Reducer.sum().group({groupField:1,groupName:'ClassID'}),
      geometry:d.aoi,scale:C.STATS_SCALE,crs:C.ANALYSIS_CRS,maxPixels:1e13,tileScale:4});
    var areaGroups=ee.List(ee.Dictionary(groupedArea).get('groups',[]));
    var areaKeys=areaGroups.map(function(g){return ee.Number(ee.Dictionary(g).get('ClassID')).format('%d');});
    var areaValues=areaGroups.map(function(g){return ee.Dictionary(g).get('sum');});
    var byClass=ee.Dictionary.fromLists(areaKeys,areaValues);
    var cropNames=ee.List(['Rice','Wheat','Sugarcane','Maize','Gram','Mustard','Vegetable','Fallow']);
    // A grouped reducer omits a key when that indicator has no unmasked pixels
    // in a crop class. ee.Dictionary.get(key) WITHOUT a default then throws.
    // Use a numeric sentinel to preserve truly missing results as null (N/A),
    // never as misleading 0%, and handle ALL indicator percentages consistently.
    function pct(g,key){
      var sentinel=-999999;
      var raw=ee.Dictionary(g).get(key,sentinel);
      var value=U.safeNumber(raw,sentinel);
      return ee.Algorithms.If(value.eq(sentinel),null,value.multiply(100));
    }
    // Returns partial per-class summaries when bands have insufficient coverage.
    d.cropAnalytics=U.collectionFromList(ee.List(ee.Dictionary(grouped).get('groups',[])).map(function(group){
      var g=ee.Dictionary(group),id=ee.Number(g.get('ClassID'));
      // Keep evidence of missing bands, instead of silently pretending they
      // were observed. Some masks (temperature, confidence or optical imagery)
      // can remove a field entirely from the per-class reducer result.
      var missing=ee.List(names).removeAll(g.keys());
      return ee.Feature(null,g).set({Crop:cropNames.get(id.subtract(1)),
        Area_ha:byClass.get(id.format('%d'),0),Irrigation_Need_Pct:pct(g,'Irrigation_Flag'),
        Disease_Risk_Pct:pct(g,'Disease_Risk'),Heat_Stress_Pct:pct(g,'Heat_Flag'),
        Low_Vigour_Pct:pct(g,'Fertilizer_Flag'),Area_Scale_m:C.STATS_SCALE,
        Indicator_Coverage:ee.Algorithms.If(missing.size().eq(0),'Complete','Partial'),
        Missing_Indicators:missing.join(', '),
        Missing_Indicator_Count:missing.size()});
    }));
  }
  var grids=d.aoi.coveringGrid(ee.Projection(C.ANALYSIS_CRS),C.GRID_METRES).map(function(f){
    return ee.Feature(f.geometry().intersection(d.aoi,ee.ErrorMargin(1))).set('Grid_ID',ee.String('GRID_').cat(f.id()));});
  d.analysisGrids=grids;
  d.gridRanking=d.analysisStack.reduceRegions({collection:grids,reducer:ee.Reducer.mean(),
    scale:C.GRID_SCALE,crs:C.ANALYSIS_CRS,tileScale:4})
    .filter(ee.Filter.notNull(['Action_Priority'])).sort('Action_Priority',false);
  d.decisionSummary=d.gridRanking.limit(20).map(function(f){return f.set('Advice',ee.Algorithms.If(
    ee.Number(f.get('Action_Priority')).gte(50),'Inspect vegetation/moisture change; verify in field','Monitor next observation'));});
  d.status04='ready';return d;
};

return exports;
})();

