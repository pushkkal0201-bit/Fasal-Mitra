    .add(d.NDWI.add(1).divide(2).multiply(0.2)).multiply(100).clamp(0,100).rename('Health_Score').updateMask(mask);
  d.weightedStressScore=ee.Image.constant(100).subtract(d.healthScore).rename('Stress_Score');
  d.monitoringStack=d.NDVI.addBands([d.NDMI,d.NDWI,d.EVI,d.temperature,d.rainfall,d.healthScore,d.weightedStressScore]).updateMask(mask);
  d.districtAverages=U.stats(d.monitoringStack,d.aoi,C);
  var area=ee.Image.pixelArea().divide(10000).updateMask(mask).rename('area_ha');
  d.totalCropArea=U.safeNumber(area.reduceRegion({reducer:ee.Reducer.sum(),geometry:d.aoi,scale:C.SCALE,
    crs:C.ANALYSIS_CRS,maxPixels:1e13,tileScale:4}).get('area_ha'),0);
  d.summaryScope=d.modelAvailable?'Predicted active crops (IDs 1–7)':'Reference mask; crop identity unavailable';
  d.cropAnalytics=ee.FeatureCollection([]);
