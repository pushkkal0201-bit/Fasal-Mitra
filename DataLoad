    function buildPassport(){
      var obs=studio.fieldReport(d,f.geometry,f.id).toDictionary();
      var quality=precision.observationQuality(d,f.geometry);
      var trust=PHENO_MODULES.trust21.provenance(d,f.geometry);
      var risk=PHENO_MODULES.risk21.summary(d,v21Risk(d),f.geometry);
      return ee.Dictionary({field_id:f.id,field_name:f.name,
