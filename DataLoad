    var cropNames=ee.List(['Rice','Wheat','Sugarcane','Maize','Gram','Mustard','Vegetable','Fallow']);
    d.cropAnalytics=U.collectionFromList(ee.List(ee.Dictionary(result).get('groups',[])).map(function(group){
      var g=ee.Dictionary(group);return ee.Feature(null,g).set('Crop',cropNames.get(ee.Number(g.get('ClassID')).subtract(1)));}));
