PHENO_MODULES.ui = (function() {
var exports = {};
// Module 05 — categorized layers, parameter explanations, high-contrast UI and live IST footer.
// UI intervals are Code Editor client timers, not server-side Earth Engine tasks.
var PHENO_ACTIVE_CLOCK_TIMER = null;
function PHENO_istClock(ms) {
  // India Standard Time remains UTC+05:30 year round; no local browser timezone assumption.
  var d = new Date(ms + 330 * 60000);
  function pad(n){ return n < 10 ? '0' + n : String(n); }
  var days = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  return {date:days[d.getUTCDay()] + ', ' + pad(d.getUTCDate()) + ' ' +
      months[d.getUTCMonth()] + ' ' + d.getUTCFullYear(),
    time:pad(d.getUTCHours()) + ':' + pad(d.getUTCMinutes()) + ':' +
      pad(d.getUTCSeconds()) + ' IST'};
}
function PHENO_layerCategory(name){
  if (/boundary|rectangle|sample|labels|review nearby|field outline/i.test(name)) return 'Boundaries & labels';
  if (/radar|sentinel-1|SAR /i.test(name)) return 'Radar';
  if (/terrain|elevation|slope/i.test(name)) return 'Terrain';
  if (/rain|temperature|heat|weather/i.test(name)) return 'Weather';
  if (/observed|count|coverage|availability|valid|reliability/i.test(name)) return 'Data coverage';
  if (/crop class|crop classification|confidence|health|priority|hotspot|stress|yield|irrigation|disease|vigour|water deficit|phenology|trend scenario|crop change/i.test(name)) return 'Crop intelligence';
  return 'Optical & indices';
}


