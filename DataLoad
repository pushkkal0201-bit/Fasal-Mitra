var PHENO_accessAttempt = 0;
function PHENO_accessKind(message) {
  var value=String(message||'').toLowerCase();
  if(/invalid authentication|oauth 2|access token|login cookie|unauthenticated|\b401\b/.test(value))
    return 'AUTHENTICATION';
  if(/permission|not registered|cloud project|not enabled|forbidden|\b403\b/.test(value))
    return 'PROJECT_ACCESS';
  return 'CONNECTION_OR_API';
}
function PHENO_accessUI(error) {
  var kind=PHENO_accessKind(error);
  var title=kind==='AUTHENTICATION' ? 'Google sign-in has expired or is invalid' :
    kind==='PROJECT_ACCESS' ? 'Earth Engine Cloud project access needs attention' :
    'Earth Engine did not complete the access test';
  var panel=ui.Panel([], ui.Panel.Layout.flow('vertical'), {
    width:'660px',padding:'22px',backgroundColor:'#FFFFFF'
  });
  panel.add(ui.Label('फसल-मित्र  /  ACCESS RECOVERY', {
    color:'#235C40',fontSize:'12px',fontWeight:'bold',margin:'0 0 12px 0'
  }));
  panel.add(ui.Label(title, {
    color:'#17382B',fontSize:'22px',fontWeight:'bold',margin:'0 0 12px 0'
  }));
  panel.add(ui.Label('Your crop records and ML code have not been changed. '+
    'The script is paused to avoid launching satellite requests without a working Earth Engine session.',
    {color:'#41534B',fontSize:'13px',margin:'0 0 16px 0'}));
  [
    '1. Save your script. In the Earth Engine Code Editor, sign out and sign back in with the correct Google account.',
    '2. In the top-right profile menu, choose Change Cloud Project and select a project registered for Earth Engine.',
    '3. Ensure the Earth Engine API is enabled, your project registration is current, and your account has the required permissions.',
    '4. Refresh the Code Editor browser tab and click Run again.',
    '5. Click Retry access check below. If it still fails, run the included standalone diagnostic in a NEW blank script.'
  ].forEach(function(item){panel.add(ui.Label(item,{
    fontSize:'13px',color:'#24392D',margin:'0 0 9px 0'
  }));});
  panel.add(ui.Label({value:'Earth Engine project setup / registration',
    targetUrl:'https://code.earthengine.google.com/register',
    style:{fontSize:'13px',color:'#1760A3',margin:'4px 0 6px 0'}}));
  panel.add(ui.Label({value:'Google: Earth Engine access requirements',
    targetUrl:'https://developers.google.com/earth-engine/guides/access',
    style:{fontSize:'13px',color:'#1760A3',margin:'0 0 16px 0'}}));
  panel.add(ui.Button({label:'← Back to project introduction',onClick:function(){
    PHENO_showIntro();
  },style:{backgroundColor:'#FFFFFF',color:'#17382B',stretch:'horizontal',margin:'3px 0'}}));
  panel.add(ui.Button({label:'Retry Earth Engine access check',
    onClick:function(){PHENO_checkAccessBeforeStart();},
    style:{backgroundColor:'#206B48',color:'#FFFFFF',stretch:'horizontal',margin:'8px 0 12px 0'}}));
  var summary=kind==='AUTHENTICATION' ? 'An OAuth credential was rejected.' :
    kind==='PROJECT_ACCESS' ? 'Cloud project setup or account permissions may be incomplete.' :
    'Could not contact or successfully query the Earth Engine API.';
  panel.add(ui.Label('DIAGNOSTIC: '+summary,{
    fontSize:'12px',color:'#7A4C20',backgroundColor:'#FFF7E8',padding:'10px'
  }));
  panel.add(ui.Label('Never paste your Google login cookie, OAuth token, API secrets or service-account credentials into this script.',{
    fontSize:'11px',color:'#68736C',margin:'12px 0 0 0'
  }));
  ui.root.clear();
  ui.root.setLayout(ui.Panel.Layout.flow('vertical'));
  ui.root.add(panel);
  print('फसल-मित्र ACCESS PREFLIGHT FAILED | category:',kind);
  print('For account safety, credentials are never requested by this app.');
}
function PHENO_checkAccessBeforeStart() {
  var attempt=++PHENO_accessAttempt;
  ui.root.clear();
  ui.root.setLayout(ui.Panel.Layout.flow('vertical'));
  // Create a fresh label and panel for EVERY attempt. A widget may have only
  // one parent in the Earth Engine UI, including across failed/retried checks.
  var bootStatus=ui.Label('फसल-मित्र v24 | Checking Google Earth Engine access…',{
    color:'#17382B',fontSize:'17px',fontWeight:'bold',
    backgroundColor:'#FFFFFF',padding:'18px'
  });
  ui.root.add(ui.Panel([bootStatus],null,{stretch:'both',backgroundColor:'#EFF4ED'}));
  try {
    // Small server-side request: confirms a usable authenticated EE session.
    // It does not prove project quota, dataset availability, or model validity.
    ee.Number(10).add(20).evaluate(function(answer,error){
      if(attempt!==PHENO_accessAttempt)return;
      if(error || answer!==30){
        PHENO_accessUI(error||'Access test returned an unexpected response.');
        return;
      }
      print('फसल-मित्र ACCESS PREFLIGHT PASSED: ee.Number(10).add(20) =',answer);
      // Local embedded counts are already available; optional label statistics
      // can be requested later from the System Tests workspace.
      startPlatform();
    });
  }catch(e){
    if(attempt===PHENO_accessAttempt)PHENO_accessUI(String(e));
  }
}
