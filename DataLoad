PHENO_MODULES.fieldStudio = (function() {
  var exports = {};
  exports.classNames = ['Rice','Wheat','Sugarcane','Maize','Gram','Mustard','Vegetable','Fallow'];
  exports.validISO = function(s) {
    if (!/^\d{4}-\d{2}-\d{2}$/.test(String(s || ''))) return false;
    var x = String(s).split('-').map(Number);
    var day = new Date(Date.UTC(x[0], x[1]-1, x[2]));
    return day.toISOString().slice(0,10) === s;
  };
  exports.comparisonDates = function(a,b,c,d,minDate,maxDate) {
    var days=[a,b,c,d];
    if (!days.every(exports.validISO)) return {ok:false,error:'Dates must be real YYYY-MM-DD values.'};
    if (!(a<=b && b<c && c<=d)) return {ok:false,error:'Periods must be ordered and must not overlap.'};
    if (a<minDate || d>maxDate) return {ok:false,error:'Comparison periods must fit inside the selected analysis window.'};
    return {ok:true};
  };
  exports.periodComposites = function(data,refStart,refEnd,comparisonStart,comparisonEnd) {
    // filterDate uses an exclusive end; each UI end date is inclusive.
    var before = data.s2.filterDate(refStart,ee.Date(refEnd).advance(1,'day'));
    var after = data.s2.filterDate(comparisonStart,ee.Date(comparisonEnd).advance(1,'day'));
    return {before:before,after:after,
      beforeImage:before.select(['NDVI','NDMI']).median(),
      afterImage:after.select(['NDVI','NDMI']).median()};
  };
  exports.fieldReport = function(data,geometry,fieldId) {
    // Values are sourced from imagery. Null is retained when cloud masking
    // leaves no observed pixels; no fabricated fallback NDVI or confidence.
    var observation = data.recentS2.select(['NDVI','NDMI','NDWI']);
    var coverage = data.NDVI.mask().unmask(0).rename('Valid_Optical');
    var combined = observation.addBands(coverage);
    var stats=combined.reduceRegion({reducer:ee.Reducer.mean(),geometry:geometry,
      scale:30,crs:data.CONFIG.ANALYSIS_CRS,maxPixels:1e9,tileScale:4});
    var area=geometry.area(1).divide(10000);
    var feature=ee.Feature(geometry,ee.Dictionary(stats)).set({
      field_id:fieldId,area_ha:area,
      selected_start:data.CONFIG.SELECTED_START,
      selected_end:data.CONFIG.SELECTED_END,
      dataset:'Sentinel-2 SR harmonized; cloud-screened',
      analytics_type:'satellite_observations_and_rules',
      release_status:'Research screening; requires field interpretation',
      developer:'Pushkkal Gupta',organization:'Pheno-Analytics Varanasi'});
    // The crop class is included ONLY when a real model was trained in session.
    if(data.modelAvailable){
      var counts=data.classified.reduceRegion({reducer:ee.Reducer.frequencyHistogram(),
        geometry:geometry,scale:30,crs:data.CONFIG.ANALYSIS_CRS,maxPixels:1e9,tileScale:4});
      feature=feature.set('crop_class_pixel_histogram',counts.get('Crop_Class'));
      feature=feature.set('model_output','Unverified RF class histogram; not a field diagnosis');
    }else{
      feature=feature.set('model_output','Classifier not trained in this session');
    }
    return feature;
  };
  exports.featureImportance = function(data) {
    // RF explain() exposes overall model split importance (not causal or SHAP).
    return ee.Dictionary(data.classifier.explain()).get('importance');
  };
  exports.getTimeSeries = function(data,geometry) {
    return data.s2.filterBounds(geometry).sort('system:time_start',false)
      .limit(90).sort('system:time_start').select(['NDVI','NDMI']);
  };
  return exports;
})();

