function PHENO_parameterDefinition(name){
  if(PHENO_PARAMETER_GUIDE[name])return PHENO_PARAMETER_GUIDE[name];
  if(/ samples$/.test(name))return {kind:'Training reference',unit:'Point samples',
    meaning:'Manually labeled points assigned to the named crop category.',
    reading:'These are source annotations, not satellite-derived crop predictions.',
    crop:'Supply examples used for training and inspecting crop-specific classifications.',
    caution:'Crop identity and date must be verified before treating them as reliable ground truth.',formula:''};
  return {kind:'Map context',unit:'As shown in legend',
    meaning:'A mapped observation, summary or administrative reference layer.',
    reading:'Interpret the layer through its value range and source acquisition date.',
    crop:'Use it alongside other crop indices and actual field observations.',
    caution:'Colour alone does not establish a crop diagnosis or treatment.',formula:''};
}

