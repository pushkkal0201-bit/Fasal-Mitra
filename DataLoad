PHENO_MODULES.risk21=(function(){
  var R={};
  R.VERSION='21.0.0';
  // Returns images and metadata lazily; expensive regional reductions only on demand.
  R.build=function(d){
    var C=d.CONFIG,region=d.aoi;
    var anchor=ee.Date(C.SELECTED_END),recentStart=anchor.advance(-30,'day');
    var rain=ee.ImageCollection('UCSB-CHG/CHIRPS/DAILY').filterBounds(region);
    function rainWindow(from,to){
      var subset=rain.filterDate(from,to).select('precipitation');
      return ee.Image(ee.Algorithms.If(subset.size().gt(0),subset.sum(),
        ee.Image.constant(0).rename('precipitation').updateMask(ee.Image.constant(0))));
    }
    var current=rainWindow(recentStart,anchor).rename('Rain_30d_mm');
    var baselines=[];
    for(var y=1;y<=5;y++)baselines.push(rainWindow(recentStart.advance(-y,'year'),anchor.advance(-y,'year')));
    var climatology=ee.ImageCollection.fromImages(baselines).mean().rename('Rain_5y_reference_mm');
    var rainPct=current.subtract(climatology).divide(climatology.max(5))
      .multiply(100).rename('Rain_anomaly_pct').clip(region);
    // Optical and radar cues are independent screening signals, NOT flood ground truth.
    var opt=d.recentS2.select('MNDWI').gt(0.2).and(d.NDVI.lt(0.25));
    var sar=d.recentS1.select('VV').lt(-16).and(d.recentS1.select('VH').lt(-23));
    var usable=d.opticalObserved.or(d.radarObserved);
    var waterCue=opt.unmask(0).and(d.opticalObserved)
      .or(sar.unmask(0).and(d.radarObserved).and(d.opticalObserved.not()))
      .rename('Potential_Water_Screen').updateMask(usable).clip(region);
    var referenceWater=ee.ImageCollection('ESA/WorldCover/v200').first().select('Map').eq(80);
    waterCue=waterCue.updateMask(referenceWater.not());
    var previousFrom=recentStart.advance(-1,'year'),previousTo=anchor.advance(-1,'year');
    var priorRaw=ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
      .filterBounds(region).filterDate(previousFrom,previousTo)
      .filter(ee.Filter.lte('CLOUDY_PIXEL_PERCENTAGE',C.MAX_CLOUD));
    var prior=priorRaw.map(function(image){
      var scl=image.select('SCL');
      var good=scl.neq(0).and(scl.neq(1)).and(scl.neq(3)).and(scl.neq(8))
        .and(scl.neq(9)).and(scl.neq(10)).and(scl.neq(11));
      return image.updateMask(good).normalizedDifference(['B8','B4']).rename('NDVI');
    });
    var blank=ee.Image.constant(0).rename('NDVI').updateMask(ee.Image.constant(0));
    var priorNdvi=ee.Image(ee.Algorithms.If(prior.size().gt(0),prior.median(),blank)).clip(region);
    var ndviDelta=d.NDVI.subtract(priorNdvi).rename('NDVI_vs_prior_year').clip(region);
    var downturn=ndviDelta.lt(-0.15).rename('Seasonal_Vegetation_Decline_Flag')
      .updateMask(ndviDelta.mask());
    // Rainfall is coarser than parcel-scale imagery: interpret risk at regional scale.
    var drought=rainPct.lt(-30).and(d.NDVI.lt(0.4))
      .rename('Rainfall_Deficit_Vegetation_Screen').updateMask(d.NDVI.mask()).clip(region);
    return {flood:waterCue,drought:drought,ndviDelta:ndviDelta,vegetationDownturn:downturn,
      rainfallAnomaly:rainPct,rainfall30d:current,referenceRain:climatology,
      metadata:ee.Dictionary({period_start:recentStart.format('yyyy-MM-dd'),
        period_end:anchor.format('yyyy-MM-dd'),reference_years:5,
        prior_s2_scene_count:priorRaw.size(),
        semantics:'Rule-based screening; not certified flood/drought diagnosis or crop-change classification',
        rainfall_resolution_note:'CHIRPS native rainfall grid is much coarser than 10m satellite pixels',
        seasonal_comparison_note:'Previous calendar year same 30-day window; cropping calendars vary'})};
  };
  R.summary=function(d,r,geometry){
    var geom=geometry||d.aoi;
    // Preserve masks so missing pixels do not become healthy/normal zeros.
    var images=ee.Image.cat([r.flood.rename('possible_water_fraction'),
      r.drought.rename('rainfall_deficit_screen_fraction'),
      r.vegetationDownturn.rename('vegetation_decline_fraction'),
      r.ndviDelta.rename('mean_ndvi_year_change')]);
    var metrics=images.reduceRegion({reducer:ee.Reducer.mean(),geometry:geom,
      scale:d.CONFIG.STATS_SCALE,maxPixels:1e8,bestEffort:true,tileScale:4});
    var rainMetrics=r.rainfallAnomaly.rename('mean_rainfall_anomaly_pct')
      .reduceRegion({reducer:ee.Reducer.mean(),geometry:geom,
        scale:5500,maxPixels:1e6,bestEffort:true,tileScale:4});
    return ee.Dictionary(metrics).combine(ee.Dictionary(rainMetrics),true)
      .combine(r.metadata,true);
  };
  return R;
})();

