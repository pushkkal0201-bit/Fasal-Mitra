    probability_calibration:'NOT_CALIBRATED',
    release_status:'NOT_VALIDATED_FOR_AUTONOMOUS_FARM_DECISIONS'
  });
  d.classifier=classifier;d.trainingSamples=p.training;d.testingSamples=p.testing;
  d.predictorNames=p.bands;d.trainingSourceFeatures=p.trainingSources;
  d.trainingDiagnostics=p.diagnostics;d.modelAvailable=true;
  d.modelReleaseStatus='RESEARCH_ONLY_PENDING_INDEPENDENT_VALIDATION';
