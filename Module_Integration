  var amplitude = values.length ? Math.max.apply(null, values) - Math.min.apply(null, values) : null;
  return {count: values.length, amplitude: amplitude,
    available: values.length >= 4 && amplitude >= 0.1};
};

exports.observedCurveRows = function (collection) {
  return collection.filter(ee.Filter.notNull(['NDVI'])).filter(ee.Filter.gt('valid_fraction', 0)).sort('time');
