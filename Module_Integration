    .addBands(d.NDVI.subtract(prior).rename('NDVI_change')).setDefaultProjection(C.ANALYSIS_CRS, null, C.SCALE).clip(d.aoi);
  var usable = exports.observedCurveRows(d.tenDaySeries);
  var count = usable.size();
  var low = U.safeNumber(usable.aggregate_min('NDVI'), 0);
  var high = U.safeNumber(usable.aggregate_max('NDVI'), 0);
  var supported = count.gte(4).and(high.subtract(low).gte(0.1));
  var peak = ee.Feature(ee.Algorithms.If(count.gt(0), usable.sort('NDVI', false).first(),
