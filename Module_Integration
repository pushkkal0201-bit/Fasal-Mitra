  if (!Array.isArray(predictors) || !predictors.length || predictors.some(function (name, i) {
    return typeof name !== 'string' || !name.length || predictors.indexOf(name) !== i ||
      ['stage_id', 'crop_id', 'observation_date'].indexOf(name) >= 0;
  })) { throw new Error('stagePredictors must be unique nonempty predictor names, excluding target/provenance properties.'); }
  var source = options.stageTraining ? ee.FeatureCollection(options.stageTraining) : ee.FeatureCollection([]);
  var crop = options.stageCropId;
  var cropValid = typeof crop === 'number' && crop >= 1 && crop <= 8 && Math.floor(crop) === crop;
  source = cropValid ? source.filter(ee.Filter.eq('crop_id', crop)) : ee.FeatureCollection([]);
  var valid = source.filter(ee.Filter.notNull(predictors.concat(['stage_id', 'crop_id', 'observation_date'])));
  var numberTypes = ee.List(['Integer', 'Long', 'Float', 'Double', 'Number']);
  valid = valid.map(function (f) {
    var numeric = ee.List(predictors.concat(['stage_id'])).map(function (name) {
      return ee.Number(numberTypes.contains(ee.Algorithms.ObjectType(f.get(ee.String(name)))));
    }).reduce(ee.Reducer.min());
    return f.set('_numeric_schema', numeric).set('_date_type', ee.Algorithms.ObjectType(f.get('observation_date')));
  }).filter(ee.Filter.eq('_numeric_schema', 1)).filter(ee.Filter.eq('_date_type', 'String'));
  valid = valid.map(function (f) {
    return f.set('_dated_label', ee.String(f.get('observation_date')).match('^\\d{4}-\\d{2}-\\d{2}($|T)').length().gt(0));
