    function canonical(stamp) {
      return stamp.length === 10 ? stamp + 'T00:00:00.000Z' : stamp.length === 20 ? stamp.slice(0,19) + '.000Z' : stamp;
    }
    var first = canonical(a.observation_date) + '|' + a.status + '|' + (a.finding || '');
    var second = canonical(b.observation_date) + '|' + b.status + '|' + (b.finding || '');
