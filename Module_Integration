    !!options.stageDiagnostics && options.stageDiagnostics.can_train === true &&
    typeof crop === 'number' && crop >= 1 && crop <= 8 && Math.floor(crop) === crop &&
    d.modelAvailable === true && !!d.classified;
};

exports.curveSupport = function (rows) {
  var values = rows.map(function (r) { return r.NDVI; }).filter(function (v) {
    return typeof v === 'number' && isFinite(v);
