    if (values[key] < 0 || values[key] > 100) throw new Error('Score threshold must be between 0 and 100: ' + key);
  });
  ['disease','irrigation','heat','lowVigour'].forEach(function(key) {
    if (values[key] < 0 || values[key] > 1) throw new Error('Flag fraction threshold must be between 0 and 1: ' + key);
  });
  if (values.highPriority < values.priority) throw new Error('highPriority must be >= priority.');
